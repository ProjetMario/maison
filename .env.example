# These optional values are verification tokens, not account passwords.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# Google Analytics 4 measurement ID, for example G-XXXXXXXXXX.
GOOGLE_ANALYTICS_ID=
# Preview is the safe default. Use true only for production output.
SITE_INDEXABLE=false
# 0: existing pages + English; 1: house guides; 2: local guides; 3: buyer guides.
CONTENT_BATCH=3
# Adds 1 directory and 1,999 sourced geographic sheets.
INCLUDE_AREA_PAGES=true
