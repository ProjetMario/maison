---
import MainLayout from '../layouts/MainLayout.astro';
import DirectContact from '../components/DirectContact.astro';
import video from '../gallery/description-des-pieces/VIDEO 1.mov';
---
<MainLayout>
  <article class="editorial">
    <header class="editorial-header"><p class="section-eyebrow">Découvrir la maison</p><h1>La maison en vidéo</h1><p class="lead">Une séquence filmée par les propriétaires pour compléter les photos avant votre visite.</p></header>
    <div class="video-wrapper"><video controls playsinline preload="none"><source src={video} type="video/quicktime" /><a href={video}>Télécharger la vidéo</a></video></div>
    <p><a href={video}>Ouvrir ou télécharger la vidéo originale</a></p>
    <DirectContact />
  </article>
</MainLayout>
