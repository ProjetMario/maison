---
import { Image } from 'astro:assets';
import MainLayout from '../layouts/MainLayout.astro';
import EnergyDetails from '../components/EnergyDetails.astro';
import property from '../data/property.json';
import { absoluteUrl, price } from '../data/seo';
import heroImg from '../gallery/landing/LANDING 2.jpg';
import poolImg from '../gallery/description-des-pieces/PSICINE 1.jpg';

const title = `Maison vue lac du Bourget à vendre | Voglans ${price()}`;
const description = `Maison à vendre avec vue sur le lac du Bourget à Voglans : ${property.area} m², ${property.bedrooms} chambres, piscine chauffée, garage double, DPE ${property.dpe}. Vente entre particuliers.`;
const facts = [
  ['Prix', price()],
  ['Surface habitable', `${property.area} m²`],
  ['Chambres', String(property.bedrooms)],
  ['Localisation', `${property.city}, ${property.region}`],
  ['Vue', 'Lac du Bourget et Dent du Chat'],
  ['Extérieurs', 'Piscine chauffée, jardin, 3 terrasses'],
  ['Stationnement', 'Garage double et stationnements'],
  ['Performance énergie', `DPE ${property.dpe}, GES ${property.ges}`],
  ['Vente', 'Direct propriétaire'],
];
const faqs = [
  {
    question: 'Où trouver une maison avec vue sur le lac du Bourget à vendre ?',
    answer: `Cette maison est à vendre à ${property.city}, en Savoie, avec une vue sur le lac du Bourget et la Dent du Chat depuis l'espace de vie et les terrasses.`,
  },
  {
    question: 'Cette maison est-elle située au Bourget-du-Lac ?',
    answer: `La maison est située à ${property.city}, commune voisine du bassin du lac du Bourget. Elle n'est pas directement au Bourget-du-Lac et n'est pas une propriété les pieds dans l'eau.`,
  },
  {
    question: 'Quel est le prix de cette maison vue lac du Bourget ?',
    answer: `Le prix demandé est de ${price()}, pour une vente directe entre particuliers.`,
  },
  {
    question: 'La maison dispose-t-elle d’une piscine ?',
    answer: 'Oui. Les extérieurs comprennent une piscine au sel chauffée par pompe à chaleur, une terrasse bois, une terrasse sud, une terrasse nord et un jardin.',
  },
  {
    question: 'Quels sont les principaux critères immobiliers du bien ?',
    answer: `La maison offre ${property.area} m² habitables, ${property.bedrooms} chambres, un garage double, une construction de ${property.yearBuilt}, un DPE ${property.dpe} et un GES ${property.ges}.`,
  },
  {
    question: 'Comment visiter la maison ?',
    answer: `La visite se prépare directement avec les propriétaires depuis la page contact du site ou par téléphone au ${property.phoneDisplay}.`,
  },
];
const schema = [
  {
    '@type': 'FAQPage',
    '@id': `${absoluteUrl('/maison-vue-lac-bourget/')}#faq`,
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: { '@type': 'Answer', text: faq.answer },
    })),
  },
];
---

<MainLayout title={title} description={description} schema={schema}>
  <article class="editorial seo-landing">
    <nav class="breadcrumb" aria-label="Fil d'Ariane"><a href="/">Accueil</a><span>/</span><span>Maison vue lac du Bourget</span></nav>
    <header class="editorial-header">
      <p class="section-eyebrow">Maison vue lac du Bourget · Voglans</p>
      <h1>Maison à vendre avec vue sur le lac du Bourget</h1>
      <p class="lead">Une maison contemporaine en duplex inversé, vendue directement par les propriétaires, avec vue sur le lac du Bourget et la Dent du Chat, piscine chauffée, garage double et DPE {property.dpe}.</p>
      <div class="seo-cta-row">
        <a class="btn btn-primary" href="/contact/">Planifier une visite</a>
        <a class="btn btn-outline" href="/description/">Voir les pièces</a>
      </div>
    </header>

    <figure>
      <Image class="editorial-image" src={heroImg} alt="Vue sur le lac du Bourget depuis la maison à vendre à Voglans" />
      <figcaption>Vue réelle depuis la maison : lac du Bourget, reliefs et Dent du Chat selon la météo.</figcaption>
    </figure>

    <section class="seo-fact-panel" aria-label="Critères immobiliers principaux">
      <h2>Annonce immobilière en bref</h2>
      <dl>{facts.map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}</dl>
    </section>

    <div class="editorial-body">
      <section class="editorial-section">
        <h2>Une maison contemporaine à Voglans avec vue sur le lac</h2>
        <p>Construite en {property.yearBuilt}, cette maison de {property.area} m² habitables propose {property.bedrooms} chambres, une piscine chauffée et un garage double. Le prix demandé est de {price()}, pour une vente directe avec les propriétaires.</p>
        <p>La maison se situe à Voglans, entre Chambéry, Aix-les-Bains et Le Bourget-du-Lac. Elle profite d’un panorama sur le lac et la Dent du Chat, tout en restant une maison de quartier résidentiel : ce n’est pas une propriété en bord d’eau ni une maison les pieds dans l’eau.</p>
      </section>

      <section class="editorial-section">
        <h2>Les critères qui comptent pour comparer</h2>
        <p>Le séjour et la cuisine ouverte sont à l’étage. Les trois chambres se trouvent au niveau inférieur, dont une suite parentale avec douche à l’italienne. Ce niveau comporte également une salle de bain avec douche et baignoire, ainsi qu’une buanderie.</p>
        <p>La configuration en duplex inversé place l’espace de vie à l’étage pour profiter de la lumière et de la vue. Les chambres sont séparées au rez-de-chaussée. Les escaliers, le voisinage, l’environnement sonore et les accès doivent être appréciés lors de la visite.</p>
      </section>

      <section class="editorial-section">
        <h2>Vue lac, piscine et vie autour du Bourget</h2>
        <p>La vue sur le lac du Bourget se découvre depuis les pièces de vie et les terrasses. La maison permet aussi de rejoindre les usages du bassin : plages publiques, port, pistes cyclables, Aix-les-Bains, Chambéry, Technolac et les reliefs savoyards.</p>
        <figure>
          <Image class="editorial-image" src={poolImg} alt="Piscine chauffée et terrasse de la maison à vendre près du lac du Bourget" loading="lazy" />
          <figcaption>Piscine au sel chauffée et terrasse bois, à distinguer des accès publics au lac.</figcaption>
        </figure>
      </section>

      <EnergyDetails />

      <section class="editorial-section faq-section">
        <h2>Questions fréquentes</h2>
        {faqs.map((faq) => (
          <details>
            <summary>{faq.question}</summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </section>

      <section class="editorial-section">
        <h2>Aller plus loin avant une visite</h2>
        <p><a href="/localisation/">Voir la localisation à Voglans</a>, <a href="/les-exterieurs/">explorer la piscine et les terrasses</a>, <a href="/les-points-forts-faibles/">lire les points forts et les points à considérer</a>, ou <a href="/contact/">contacter les propriétaires</a>.</p>
      </section>
    </div>
  </article>
</MainLayout>
