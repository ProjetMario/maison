---
import '../styles/modern.css';
import '../styles/seo.css';
import siteConfig from '../../site.config.mjs';
import Footer from '../components/Footer.astro';
import NavBar from '../components/NavBar.astro';
import PropertyFacts from '../components/PropertyFacts.astro';
import ContactMeasurement from '../components/ContactMeasurement.astro';
import property from '../data/property.json';
import { pages, pathKey, absoluteUrl, alternatives, indexable, type Language } from '../data/seo';
import { getImage } from 'astro:assets';
import { lastModified } from '../data/sitemap';
import cover from '../gallery/landing/LANDING 2.jpg';

interface Props { title?: string; description?: string; lang?: Language; image?: string; article?: boolean; noindex?: boolean; schema?: Record<string, unknown>[]; mainEntity?: string; }
const path = pathKey(Astro.url.pathname);
const { lang = 'fr', article = false, noindex = false } = Astro.props;
const meta = pages[path] ?? pages['/'];
const title = Astro.props.title ?? meta.title;
const description = Astro.props.description ?? meta.description;
const canonical = absoluteUrl(path);
const shareImage = Astro.props.image ?? (await getImage({ src: cover, width: 1200, format: 'jpeg', quality: 80 })).src;
const alternateLinks = alternatives(path);
const en = lang === 'en';
const home = en ? '/en/' : '/';
const listing = path === '/' || path === '/en/' || path === '/maison-vue-lac-bourget/';
const googleAnalyticsId = process.env.GOOGLE_ANALYTICS_ID ?? process.env.PUBLIC_GA_MEASUREMENT_ID;
const graph: Record<string, unknown>[] = [
  { '@type': 'WebSite', '@id': `${property.origin}/#website`, url: `${property.origin}/`, name: property.name, inLanguage: ['fr', 'en'] },
  { '@type': article ? 'Article' : (listing ? 'RealEstateListing' : 'WebPage'), '@id': `${canonical}#page`, url: canonical, name: title, ...(!noindex ? { dateModified: lastModified(path) } : {}), ...(article ? { headline: title, author: { '@type': 'Person', name: en ? 'The property owners' : 'Les propriétaires' } } : {}), description, inLanguage: lang, image: absoluteUrl(shareImage), isPartOf: { '@id': `${property.origin}/#website` }, ...(Astro.props.mainEntity ? { mainEntity: { '@id': Astro.props.mainEntity } } : {}) },
];
if (listing) {
  graph.push({ '@type': 'SingleFamilyResidence', '@id': `${property.origin}/#house`, name: en ? 'Lake-view house in Voglans' : 'Maison avec vue lac à Voglans', url: absoluteUrl('/'), image: absoluteUrl(shareImage), numberOfBedrooms: property.bedrooms, yearBuilt: property.yearBuilt, floorSize: { '@type': 'QuantitativeValue', value: property.area, unitCode: 'MTK' }, address: { '@type': 'PostalAddress', streetAddress: property.street, addressLocality: property.city, postalCode: property.postalCode, addressRegion: property.region, addressCountry: property.country }, geo: { '@type': 'GeoCoordinates', latitude: property.latitude, longitude: property.longitude }, amenityFeature: [
    { '@type': 'LocationFeatureSpecification', name: 'Vue sur le lac du Bourget', value: true },
    { '@type': 'LocationFeatureSpecification', name: 'Piscine au sel chauffée', value: true },
    { '@type': 'LocationFeatureSpecification', name: 'Garage double', value: true },
    { '@type': 'LocationFeatureSpecification', name: `DPE ${property.dpe}`, value: true },
    { '@type': 'LocationFeatureSpecification', name: `GES ${property.ges}`, value: true },
  ] });
  graph[1].mainEntity = { '@id': `${property.origin}/#house` };
}
if (listing) {
  graph[1].offers = { '@type': 'Offer', price: property.price, priceCurrency: property.currency, url: canonical, availability: property.status === 'sold' ? 'https://schema.org/SoldOut' : property.status === 'under-offer' ? 'https://schema.org/Reserved' : 'https://schema.org/InStock', itemOffered: { '@id': `${property.origin}/#house` } };
}
const parent = article ? { name: 'Guides', path: '/guides/' } : path.startsWith('/reperes/') && path !== '/reperes/' ? { name: 'Repères', path: '/reperes/' } : null;
if (path !== home) graph.push({ '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: en ? 'Home' : 'Accueil', item: absoluteUrl(home) }, ...(parent ? [{ '@type': 'ListItem', position: 2, name: parent.name, item: absoluteUrl(parent.path) }] : []), { '@type': 'ListItem', position: parent ? 3 : 2, name: title, item: canonical }] });
graph.push(...(Astro.props.schema ?? []));
const favicon = siteConfig.favicon;
---

<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/x-icon" href={`/${favicon}`} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="alternate" type="application/rss+xml" title={property.name} href={absoluteUrl('/feed.xml')} />
		<meta name="robots" content={!indexable || noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
		{alternateLinks.map(({ lang, path }) => <link rel="alternate" hreflang={lang} href={absoluteUrl(path)} />)}
		{process.env.GOOGLE_SITE_VERIFICATION && <meta name="google-site-verification" content={process.env.GOOGLE_SITE_VERIFICATION} />}
		{process.env.BING_SITE_VERIFICATION && <meta name="msvalidate.01" content={process.env.BING_SITE_VERIFICATION} />}
		{googleAnalyticsId && (
			<>
				<script async src={`https://www.googletagmanager.com/gtag/js?id=${googleAnalyticsId}`}></script>
				<script set:html={`
					window.dataLayer = window.dataLayer || [];
					function gtag(){dataLayer.push(arguments);}
					gtag('js', new Date());
					gtag('config', '${googleAnalyticsId}');
				`.replace(/</g, '\\u003c')} />
			</>
		)}
		<script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c')} />
		
		<!-- PWA Meta Tags -->
		<link rel="manifest" href="/manifest.json" />
		<meta name="theme-color" content="#d4a574" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
		<meta name="apple-mobile-web-app-title" content="Maison Lac" />
		<link rel="apple-touch-icon" href="/favicon.ico" />
		
		<!-- Open Graph -->
		<meta property="og:type" content={article ? 'article' : 'website'} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:locale" content={en ? 'en_GB' : 'fr_FR'} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={absoluteUrl(shareImage)} />
		<meta property="og:image:alt" content={en ? 'View from the house in Voglans' : 'Vue depuis la maison à Voglans'} />
		<meta name="twitter:card" content="summary_large_image" />
		<noscript><style>.reveal,.text-reveal,.text-reveal-stagger>*{opacity:1;transform:none}</style></noscript>
	</head>
	<body>
		<!-- Scroll Progress Bar -->
		<div class="scroll-progress" id="scrollProgress"></div>
		<!-- Cursor Glow -->
		<div class="cursor-glow" id="cursorGlow"></div>
		<NavBar lang={lang} path={path} />
		<main>
			<slot />
			{!noindex && <PropertyFacts lang={lang} />}
		</main>
		<Footer lang={lang} />
		<ContactMeasurement />
		
		<!-- Bouton flottant Appeler -->
		<a href={`tel:${property.phone}`} class="floating-cta" aria-label={en ? 'Call the owners' : 'Appeler les propriétaires'} data-contact="phone">
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
				<path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 011 1v3.49a1 1 0 01-1 1C10.07 21 3 13.93 3 5a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.46.57 3.58a1 1 0 01-.24 1.01l-2.21 2.2z"/>
			</svg>
			<span>{en ? 'Call' : 'Appeler'}</span>
		</a>

		<!-- Script animations au scroll -->
		<script>
			// Register Service Worker for PWA
			if ('serviceWorker' in navigator) {
				window.addEventListener('load', () => {
					navigator.serviceWorker.register('/sw.js')
						.then((reg) => console.log('SW registered'))
						.catch((err) => console.log('SW registration failed'));
				});
			}

			document.addEventListener('DOMContentLoaded', () => {
				// Reveal animations
				const reveals = document.querySelectorAll('.reveal');
				const observer = new IntersectionObserver((entries) => {
					entries.forEach(entry => {
						if (entry.isIntersecting) {
							entry.target.classList.add('visible');
						}
					});
				}, {
					threshold: 0.1,
					rootMargin: '0px 0px -50px 0px'
				});
				reveals.forEach(el => observer.observe(el));

				// Parallax effect on hero
				const heroBg = document.querySelector('.hero-bg img');
				if (heroBg) {
					window.addEventListener('scroll', () => {
						const scrolled = window.pageYOffset;
						const rate = scrolled * 0.4;
						(heroBg as HTMLElement).style.transform = `translateY(${rate}px)`;
					}, { passive: true });
				}

				// Scroll progress bar
				const scrollProgress = document.getElementById('scrollProgress');
				if (scrollProgress) {
					window.addEventListener('scroll', () => {
						const scrollTop = window.scrollY;
						const docHeight = document.documentElement.scrollHeight - window.innerHeight;
						const scrollPercent = (scrollTop / docHeight) * 100;
						scrollProgress.style.width = scrollPercent + '%';
					}, { passive: true });
				}

				// Animated counters
				const counters = document.querySelectorAll('.counter');
				const counterObserver = new IntersectionObserver((entries) => {
					entries.forEach(entry => {
						if (entry.isIntersecting) {
							const target = entry.target as HTMLElement;
							const finalValue = target.dataset.value || target.innerText;
							const isNumber = /^\d+$/.test(finalValue.replace(/\s/g, ''));
							
							if (isNumber) {
								const end = parseInt(finalValue.replace(/\s/g, ''));
								let current = 0;
								const increment = end / 50;
								const timer = setInterval(() => {
									current += increment;
									if (current >= end) {
										target.innerText = finalValue;
										clearInterval(timer);
									} else {
										target.innerText = Math.floor(current).toString();
									}
								}, 30);
							}
							counterObserver.unobserve(target);
						}
					});
				}, { threshold: 0.5 });
				counters.forEach(el => counterObserver.observe(el));

				// Cursor glow effect
				const cursorGlow = document.getElementById('cursorGlow');
				if (cursorGlow && window.innerWidth > 768) {
					document.addEventListener('mousemove', (e) => {
						cursorGlow.style.left = e.clientX + 'px';
						cursorGlow.style.top = e.clientY + 'px';
						cursorGlow.classList.add('active');
					});
					document.addEventListener('mouseleave', () => {
						cursorGlow.classList.remove('active');
					});
				}

				// Text reveal animations
				const textReveals = document.querySelectorAll('.text-reveal, .text-reveal-stagger');
				const textObserver = new IntersectionObserver((entries) => {
					entries.forEach(entry => {
						if (entry.isIntersecting) {
							entry.target.classList.add('visible');
						}
					});
				}, { threshold: 0.2 });
				textReveals.forEach(el => textObserver.observe(el));
			});
		</script>
	</body>
</html>
